generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                         Int                  @id @default(autoincrement())
  email                      String               @unique
  password                   String?
  nome                       String
  nomeConfeccao              String?
  whatsapp                   String?
  avatarUrl                  String?
  plano                      String               @default("basico")
  subscriptionId             String?
  nextPayment                DateTime?
  configuracaoExpressaStatus String?
  configuracaoExpressaData   DateTime?
  mentoria30DiasStatus       String?
  mentoria30DiasInicio       DateTime?
  mentoria30DiasCheckins     Int?                 @default(0)
  moduloAuditoria            Boolean              @default(false)
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  accessTokens               AccessToken[]
  faccoes                    Faccao[]
  ordens                     Ordem[]
  resetTokens                PasswordResetToken[]
}

model AccessToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("access_tokens")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

model Faccao {
  id        Int      @id @default(autoincrement())
  codigo    String
  nome      String
  contato   String?
  ativo     Boolean  @default(true)
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])
  ordens    Ordem[]

  @@unique([userId, codigo])
  @@map("faccoes")
}

model Ordem {
  id            Int      @id @default(autoincrement())
  numeroOrdem   String   @map("numero_ordem")
  produto       String
  dataEnvio     DateTime @map("data_envio") @db.Date
  prazoAcordado DateTime @map("prazo_acordado") @db.Date
  qtdEnviada    Int      @map("qtd_enviada")
  qtdRetornada  Int      @default(0) @map("qtd_retornada")
  observacao    String?
  userId        Int      @map("user_id")
  faccaoId      Int      @map("faccao_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  faccao        Faccao   @relation(fields: [faccaoId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@unique([userId, numeroOrdem])
  @@index([faccaoId])
  @@map("ordens_producao")
}
